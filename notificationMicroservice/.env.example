RABBITMQ_URL=amqp://guest:guest@localhost:5672/
HTTP_PORT=8084

# Notifier selection: "mock" (logs only) or "acs" (Azure Communication Services)
NOTIFIER_TYPE=mock
FROM_NAME=Car Rental

# Local user→email read model (populated from user.registered events)
USER_DB_PATH=/data/users.db

# Frontend URL is used to build clickable password-reset links
FRONTEND_BASE_URL=http://localhost:3000

# ─── Azure Communication Services (only when NOTIFIER_TYPE=acs) ─────
# Production: managed_identity (no secrets needed, role-assigned in Bicep)
# Local dev:  connection_string (set ACS_CONNECTION_STRING_FILE)
ACS_ENDPOINT=
ACS_SENDER_ADDRESS=
ACS_AUTH_MODE=managed_identity
ACS_CONNECTION_STRING_FILE=
# Or inline (non-prod only — never commit a real value):
# ACS_CONNECTION_STRING=
