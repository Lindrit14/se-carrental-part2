# --- HTTP -----------------------------------------------------------
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_SHUTDOWN_TIMEOUT=15s
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Logging --------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# --- MongoDB --------------------------------------------------------
MONGO_URI=mongodb://root:example@localhost:27017
MONGO_DATABASE=auth
MONGO_CONNECT_TIMEOUT=10s

# --- RabbitMQ -------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=user.events
RABBITMQ_RECONNECT_BACKOFF=5s

# --- JWT (RS256) ----------------------------------------------------
# Two ways to provide the keys (use ONE):
#  1. _FILE: path to a PEM file (recommended — docker-compose mounts ./secrets/).
#     Run `make gen-keys` once, then leave the inline vars empty.
#  2. Inline PEM as a single line (literal "\n" is accepted as newline).
JWT_PRIVATE_KEY_FILE=
JWT_PUBLIC_KEY_FILE=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=user-auth
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=336h

# --- Auth-Policy ----------------------------------------------------
PASSWORD_MIN_LENGTH=12
BCRYPT_COST=12
LOGIN_RATE_LIMIT_PER_MIN=5
REGISTER_RATE_LIMIT_PER_MIN=5

# --- Password-Reset -------------------------------------------------
PASSWORD_RESET_TTL=30m
