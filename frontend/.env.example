# Local-dev backend URLs (used by Vite dev server).
# In production builds these get baked at build time; the nginx image
# proxies API calls so empty values fall back to relative paths.
VITE_AUTH_URL=http://localhost:8080
VITE_BOOKING_URL=http://localhost:8082
VITE_CURRENCY_URL=http://localhost:8000

# Google Maps JavaScript API key with the Places library enabled.
# Required for the search-bar location autocomplete; if empty, the input
# falls back to a plain text field.
VITE_GOOGLE_MAPS_API_KEY=put api key here
